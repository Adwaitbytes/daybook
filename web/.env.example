# Copy to .env.local. Nothing here is required for the site to build; each missing value has a designed state.

# RPC endpoints (public defaults are used when unset)
LASNA_RPC_URL=https://lasna-rpc.rnk.dev/
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
UNICHAIN_SEPOLIA_RPC_URL=https://sepolia.unichain.org

# Preview a real deployment before its record lands in contracts/deployments (the generated record wins).
DAYBOOK_REACTIVE_ADDRESS=

# Neon Postgres, schema "daybook" (off-chain invoice details, durable rate limits, traced-hop cache).
# Optional: every page works from chain alone when it is unset or down.
DATABASE_URL=

# Demo relayer for "Pay a demo invoice". A dedicated low-balance wallet, never the deployer. Never commit it.
DEMO_RELAYER_PK=
# Open demo invoices the relayer may pay when it does not own the contract, e.g. 12,13,14
DEMO_INVOICE_IDS=
# When the relayer owns the demo contract it creates invoices itself with this policy and amount (6 decimals).
DEMO_POLICY_ID=1
DEMO_AMOUNT_UNITS=100000

# Fixture state gallery at /design/states, for design review only.
DAYBOOK_STATE_GALLERY=
NEXT_PUBLIC_SITE_URL=
